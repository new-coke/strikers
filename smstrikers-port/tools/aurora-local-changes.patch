+// WebGPU requires bytes-per-row of a texture copy to be a multiple of 256.
+constexpr uint32_t kRowAlign = 256;
+constexpr uint32_t align_up(uint32_t v, uint32_t a) { return (v + a - 1) & ~(a - 1); }
