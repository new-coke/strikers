# strikers.ini, rename or copy this to strikers.ini beside the executable.
# Vita: strikers-vita.ini.example is the complete current GXM baseline, also
# generated automatically when ux0:data/strikersVita/strikers.ini is missing.
# It includes the automatic test match and finite gameplay FPS capture.

# Handheld / battery: uncomment these three together on a Steam Deck or any machine running on one.
#   fps_limit = 40
# vsync = 1 # Fifo blocks and lets the GPU idle; Mailbox renders frames the panel never shows, which
# on a battery is heat.
#   msaa      = 1
# res_scale is deliberately absent: the default already renders the Deck's panel pixel for pixel.

[display]
# Vita GXM internal resolution, selected once at startup. Restart to change.
# auto preserves the build default; 960x544 renders at panel resolution;
# 640x480 uses the existing offscreen EFB and GPU upscale to the 960x544 panel.
# This changes rasterization resolution, including HUD; it does not skip draws.
# gxm_internal_resolution = auto

# Internal render resolution, as a multiple of the console's 448 rows. Unset, it follows the window;
# on a Steam Deck it is the panel's 800 rows (1.786) even when docked.
# res_scale = 2.0

# Multisampling. Init-time only. 1 is the default and 4 is the only other value worth setting.
# msaa = 1

# Anisotropic texture filtering: 1, 2, 4, 8 or 16.
# aniso = 16

# Frame rate cap in Hz, or 0 for unlimited.
# fps_limit = 59.94

# 1 waits for each refresh of your display and gives the steadiest picture. 0 makes the
# controls more responsive and keeps the frame rate up when your graphics card struggles.
# Where your system supports it, 0 still avoids tearing.
# vsync = 1

# Aspect ratio: auto, 16:9, 4:3, 21:9, any W:H, or a decimal.
# aspect = auto

# Window size, WIDTHxHEIGHT. Unset, the window opens maximised and restores to the largest
# standard 16:9 size that fits the screen.
# window_size = 1600x900

# 1 opens fullscreen and 0 a window. Unset, it is fullscreen under Steam's Game Mode (gamescope),
# which scales a window into the screen with black bars, and a window everywhere else.
# fullscreen = 1

# Stop the game when its window loses focus. 0 by default and deliberately: the attract mode and the
# demo match are worth leaving to run, and a benchmark that stopped would report nothing.
# pause_on_focus_lost = 1

# Graphics backend: auto, d3d12, vulkan, metal, opengl, opengles.
# backend = vulkan

# Vita: GPU matrix/normal/lighting/texgen for eligible dynamic vertices.
# Keep 0 for the validated CPU fallback; 1 enables the streamed GPU experiment.
# Restart Strikers after changing this. It is independent of test match/frameskip.
# gxm_streamed_vertex_gpu = 0
# Diagnostic-only census of decoded vertices before matrices/lighting. Samples
# one renderer frame in 16; reports whole-stream and cross-draw position/normal
# reuse in performance_capture. Never enables a geometry cache or skips a draw.
# Requires diagnostics=1; leave off for FPS measurements.
# gxm_vertex_reuse_probe = 0

# Independent Vita experiments (restart after changes, default 0).
# A5: no per-draw parse for simple, immutable, pinned GX display lists.
# Existing FIFO one-draw direct path only, ordered on GX consumer. OFF default.
# gxm_prepared_dl = 0

# A5 per-frame state write guards (OFF by default; test independently):
# Skip bit-identical XF texture/normal/post-texture matrix writes.
# gxm_xf_equal_matrix_writes = 0
# Skip inactive / semantically identical decoded TEV stage invalidations.
# gxm_tev_decoded_write_gate = 0
# Reuse CPU uniform snapshots across BP depth/blend-only pipeline changes.
# gxm_raster_uniform_reuse = 0
# Native position/normal palette transport for pointlit Characters; async GX only.
# Keeps the existing geometry/material draw path. Independent of native-model caches.
# gxm_native_pn_palette = 0
# Exact compact CMPR subset as BC1; other textures keep lossless fallback.
# gxm_exact_bc1 = 0
# Immutable geometry buffers prefer CDRAM, retaining USER allocation fallback.
# gxm_resident_cdram = 0
# Consume native/v1 sidecars from asset_archive, if prepared by the host compiler.
# gxm_native_assets = 1

# Shaders compiled at once, 0 to 16. 0 picks a count from the CPU cores. Set 1 if the graphics driver
# has problems at startup.
# shader_jobs = 0

[audio]
# Sound: music, effects, the stadium reverb and the movies' own tracks.
# audio = 0

# Master level, 0 to 2, in front of the limiter.
# audio_volume = 1.0

# Report at exit: ticks rendered, underruns, and whether any non-silent sample was produced; plus
# the mixer's state every two seconds.
# log_audio = 1

[input]
# Controls. Everything here is commented out and the defaults below are what you get without the
# file.
# STRIKERS_PROBE_PAD=1 prints the whole effective table at startup, which is
# also the answer to "what are my controls".

# keyboard = 1            ; 0 disables the keyboard pad

# Button art: auto follows the last input device; a named family overrides the art.
# button_prompts = auto

# Keyboard, player 1. SDL scancode names as SDL_GetScancodeName spells them: "A", "Return", "Space",
# "Left Shift", "F1", "Keypad 0". STRIKERS_PROBE_PAD=1 prints the whole effective table.
# key_a = X
# key_b = Z
# key_x = C
# key_y = V
# key_z = Space
# key_start = Return
# key_l = Q
# key_r = E
# key_dpad_up = Up
# key_dpad_down = Down
# key_dpad_left = Left
# key_dpad_right = Right
# key_stick_up = W
# key_stick_down = S
# key_stick_left = A
# key_stick_right = D
# key_cstick_up = I
# key_cstick_down = K
# key_cstick_left = J
# key_cstick_right = L

# Gamepad (all ports). Values are SDL gamepad button names: a b x y back guide start leftstick
# rightstick leftshoulder rightshoulder dpup dpdown dpleft dpright, and for triggers: lefttrigger
# righttrigger.
# pad_a = a
# pad_b = b
# pad_x = x
# pad_y = y
# pad_z = rightshoulder
# pad_start = start
# pad_l = lefttrigger
# pad_r = righttrigger
# pad_dpad_up = dpup
# pad_dpad_down = dpdown
# pad_dpad_left = dpleft
# pad_dpad_right = dpright
# pad_swap_sticks = 0     ; 1 swaps the main stick and the C-stick
# pad_deadzone = 0.24     ; 0.0 .. 0.9, fraction of stick radius
# pad_trigger_threshold = 0.95
# pad_rumble = 1          ; 0 turns rumble off on every port
# pad_rumble_strength = 100   ; 0..100

[paths]
# Where the game data is: either the `files` folder of an extracted disc, or a disc image.
# data = C:/games/strikers/files
# data = C:/games/strikers/Super Mario Strikers.iso

# Recommended Vita data source: verified PSARC made by tools/vita_prepare_assets.py.
# Enable after copying the archive; this overrides sms.iso for normal gameplay.
# Keep the source ISO on the host for regeneration. ISO-only installs can leave
# this unset to use the usual data path.
# asset_archive = ux0:data/strikersVita/sms.psarc
# Optional archive I/O observation. Default OFF; samples stay in RAM until the
# finite capture completes. Times measure CPU-observed read/inflate duration.
# asset_io_profile = 0
# asset_io_capture = ux0:data/strikersVita/perf-io.csv
# asset_io_capture_skip = 600
# asset_io_capture_frames = 120

# Optional small PSARC containing only native/v1 sidecars. Requires
# gxm_native_assets=1; absent, Aurora reads sidecars from asset_archive instead.
# native_asset_archive = ux0:data/strikersVita/sms-native-cache.psarc
# Native PCM preserves the current mixer, loop and resampling semantics. On for Vita;
# the original ADPCM decoder handles any missing or mismatching frame.
# vita_native_audio = 1
# Converted movies use SceAvcdec hardware H.264, retaining original THP audio
# and timing. On for Vita. Missing movie sidecars
# use the original movie path (movies are skipped on Vita without a decoder).
# vita_native_video = 1

# Where the game's reports go: 1 for strikers-log.txt beside it, a file path, or console.
# log = 1
# log = console

# Menu language: english, german, french, spanish or italian, and japanese on the Japanese disc.
# Unset keeps the disc's own language. The American disc ignores this.
# language = german

# Texture packs load from mods/textures/ beside the game and mods/textures/ in the user folder. A
# folder named here loads too and wins over both; 0 turns texture packs off.
# textures = C:/games/strikers/packs/hd pitch

# One pack out of the textures folders, by its folder name. Unset loads every pack.
# texture_pack = hd pitch

# Memory for loaded texture pack images, in MB. Past it the least recently drawn is dropped and
# loaded again when next needed. 4096 by default, 512 on Switch.
# texture_cache_mb = 1024

# Save each texture the game loads as a PNG named for a texture pack, in a folder per disc file.
# 1 saves to texture_dumps/ in the user folder; a path saves there.
# texture_dump = 1

[game]
# Vita: start the automatic CPU-vs-CPU friendly used for device tests.
# 0 keeps the normal frontend; 1 starts the test match. Current Vita default 1.
# This does not change the original title-screen attract demo.
# vita_test_match = 1

# Independent pose/matrix jobs may use the quota-controlled CPU3 helper.
# Default 0; requires vita_core3=auto/on and retains the total-core usage limit.
# vita_game_core3 = 0
# Separate per-view skin matrix preparation experiment, default 0.
# vita_skin_packets = 0

# Vita: adaptive gameplay frameskip. Default 0; 1 lets the simulation catch up
# to wall time and drops up to three rendered frames through glDiscardFrame.
# Restart the game after changing either setting. Frameskip is inactive when
# fixed_dt is nonzero; use fixed_dt = 0 for normal gameplay with frameskip.
# vita_frameskip = 0
# fixed_dt = 0

# Vita match pause/debug menu (L+R+SELECT). On in the current Vita baseline, independent of
# diagnostics=0; enable for runtime fragment-program ON/OFF A/B testing.
# Shader toggles last until restored or the game exits; they never change this INI.
# vita_debug_menu = 1

# Detailed GX view/native-draw attribution (heavy diagnostic, not quiet FPS).
# Captures 12 gameplay frames after 600 warmup frames to view-draw-raw.jsonl;
# seal raw data with the exact SELF/INI/shader-cache before interpreting results.
# vita_view_draw_capture = 0
# vita_view_draw_skip = 600
# vita_view_draw_frames = 12
# vita_view_draw_capacity = 8192
# Optional extra CPU work: hash referenced indexed-vertex bytes, indices,
# GPU uniform snapshots and sampler/viewport/scissor for stronger A1c A/B
# equivalence tests. Not a GPU benchmark; use only on a short diagnostic run.
# vita_view_draw_payloads = 0

# A2a CPU-only redundant position XF write experiment. Default OFF; never
# changes pose, skinning, shadow quality, draw order or shader programs.
# gxm_xf_equal_pos_writes = 0

# A3 indexed-PN vertex uniform delta upload experiment. OFF by default.
# Always reserves a fresh GXM default-uniform buffer; restores a CPU-owned
# complete prepared image before uploading only changed uniform groups.
# Never enables streamed GPU vertex mode or skips any character/shadow draw.
# gxm_uniform_delta_upload = 0

# A4 shader generation experiment. Native GXM arithmetic TEV only, no effects
# or draws disabled. 0=reference, 1=reuse identical texture/coord fetches,
# 2=drop unused TEV color/alpha computations, 3=both. Default OFF.
# gxm_a4_fragment_opt = 0

# Native GXM static geometry AVNR v2: final prepacked GPU layout, direct
# immutable VB/IB admission. Requires a NEW sidecar generated with
# --native-gxm-static and native_asset_archive pointing to it. Default OFF.
# gxm_native_gpu_static = 0

# After a Vita hardware freeze, STRIKERS_VITA_GXM_LEAN_RENDER defaults OFF
# pending an isolated validation. It is a CMake build option, not an INI key.
# This strips the experimental A6/R1-R3 GLX recipe/replay hooks and packet
# timing probes from the game; INI flags below cannot re-enable stripped code.
# Re-enable the lean path only in a controlled test build with
# STRIKERS_GXM_LEAN_RENDER=ON, keeping the R3-A Aurora options unchanged.
# The validated GXM renderer, GX worker, static GPU geometry and fallback remain.

# A6 phase 1: opt-in same-frame GX decoding bypass for consecutive identical,
# immutable, unlit and untextured packets whose AVNR v2 GXM buffer is resident.
# Uses pinned display-list identity and exact-slot original GX fallback.
# Does NOT yet bypass GX for characters, shadows or animated materials.
# gxm_native_draw_replay = 0

# Native model/draw recipe experiment, disabled by default.
# 1: original static-unlit branch, position/color and no textures.
# 2: intercept only the DL draw slot, retaining original GLX state/userdata
# updates; textured/lit/indexed-PN resident geometry uses current texture,
# TLUT and EFB resolution, with reference GX fallback. Requires GX worker.
# Aurora-Vita now owns the typed model registry and admission/capture path;
# mode 2 still pays live GX state/uniform costs and has NOT shown an FPS gain.
# gxm_native_model_draw = 0
# Opt-in CPU recipe cache: 256 entries, four-way lookup, selective replacement.
# Producer/consumer capacity is coordinated with a 384-live-recipe ceiling.
# Geometry remains at its separately configured budget. Requires mode 1 or 2.
# gxm_native_model_cache = 0
# Use the ordinary incremental fixed-uniform builder for native recipes.
# Complete snapshots and GXM disable bits remain enforced. No GX state caching
# or GPU reservation policy change; geometry budget is unchanged. Opt-in only.
# gxm_native_model_uniform_build = 0
# Reuse native-recipe CPU vertex/fragment preparation while tracked GX inputs
# are unchanged. Permanent DLs receive loader generations and owner-scope
# retirement. Live texture/TLUT/EFB changes and exact GX fallback remain active.
# Experimental, default OFF; requires native model mode 1 or 2. Restart after
# changing this; temporary/unregistered DLs retain the original GX path.
# gxm_native_model_prepared = 0
# R3-A (GXM only): an already compiled static/unlit model in a permanent
# registered display list may bypass an unchanged GLX producer callback. Every
# material/texture/geometry change is validated in Aurora's GPU owner thread.
# Requires native model draw=2, prepared=1, and async GX. Stays default OFF
# until matched scene/image/FPS hardware validation proves a benefit.
# gxm_native_model_early = 0
# Diagnostic producer census covers the mode-1 filter only; requires
# diagnostics=1. Use native_model_* counters for mode-2 coverage.
# gxm_native_model_census = 0
# Independently collect producer/consumer cache events without enabling the
# admission census. Diagnostic-only: mutex accounting affects frame times.
# gxm_native_model_metrics = 0

# Which disc the data came from, when the data cannot say: the id is read from sys/boot.bin
# beside `files` or from an image's first bytes, and an extraction of `files` alone is taken
# as the USA disc. usa, europe or japan, or a disc id (G4QE01, G4QP01, G4QJ01).
# region = europe

# Every stadium, team and cup mode available.
# unlock_all = 1

[discord]
# Your Discord status while the game runs: in the menus, or a match's mode, cup round, stadium,
# captains, score and time left. Off by default; 1 turns it on while Discord's desktop app runs.
# discord = 1

[debug]
# Master diagnostic switch, read at startup. Restart the game after changing it.
# 1 permits the individually selected logs/probes/profilers (default).
# 0 disables diagnostic logs, dumps, task/view/FIFO and native GXM profiling.
# Renderer fast paths, clocks and required CPU3 quota accounting are unchanged.
# diagnostics = 1

# Vita: keep the same minimal FPS counter in both diagnostic profiles (default 1).
# Set 0 with diagnostics=0 to remove its timing/display too; then measure externally.
# fps_overlay = 1

# Completed GX-consumer samples without producer run_sync/fences.
# Requires diagnostics=1. The path enables bounded attribution timers, suppresses
# per-command GX clock reads and full tracing, and writes once after the sample.
# Timers still perturb execution; use a separate diagnostics=0 FPS capture.
# performance_capture = ux0:data/strikersVita/performance.csv
# performance_capture_frames = 600 # maximum 3600
# performance_capture_skip = 600   # live-play iterations before sampling

# The debug overlay and menu. `menu` opens the menu straight away, `1` draws only the compact
# heads-up form.
# overlay = menu

# Vita profiling builds can record a VitaDebugger v2 trace without running GDB. The file is
# written by a dedicated consumer while the game, renderer and audio worker keep recording
# into a bounded non-blocking ring. Copy the finished .vptrace back to the development machine
# and open/export it with VitaDebugger's profiler tools.
# vita_profile = 1
# vita_profile_path = ux0:data/strikersVita/profile.vptrace

# Force a stadium instead of letting the demo pick at random.
# force_stadium = mario_stadium

# Pin the RNG seed, so a run is reproducible.
# seed = 3

# Vita native candidate (build defaults, override with 0 to compare after restart).
# aurora_distinct_cpu_cores = 1
# gxm_immediate_draw_view = 1
# gxm_local_draw_batching = 0  # Direct streamed submission is required to exercise the view.
