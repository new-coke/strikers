# strikers.ini, rename or copy this to strikers.ini beside the executable.

# Handheld / battery: uncomment these three together on a Steam Deck or any machine running on one.
# With vsync the GPU waits for the panel and idles. Without it the game also draws frames the panel
# never shows and drains the battery.
#   fps_limit = 40
#   vsync     = 1
#   msaa      = 1
# res_scale is deliberately absent: the default already renders the Deck's panel pixel for pixel.

[display]
# Internal render resolution, as a multiple of the console's 448 rows. Unset, it follows the window;
# on a Steam Deck it is the panel's 800 rows (1.786) even when docked.
# res_scale = 2.0

# Multisampling. Init-time only. 1 is the default and 4 is the only other value worth setting.
# msaa = 1

# Anisotropic texture filtering: 1, 2, 4, 8 or 16.
# aniso = 16

# Frame rate cap in Hz, or 0 for unlimited.
# fps_limit = 59.94

# 1 waits for each refresh of your display and gives the steadiest picture. 0 makes the
# controls more responsive and keeps the frame rate up when your graphics card struggles.
# Where your system supports it, 0 still avoids tearing.
# vsync = 1

# Aspect ratio: auto, 16:9, 4:3, 21:9, any W:H, or a decimal.
# aspect = auto

# Window size, WIDTHxHEIGHT. Unset, the window opens maximised and restores to the largest
# standard 16:9 size that fits the screen.
# window_size = 1600x900

# 1 opens fullscreen and 0 a window. Unset, it is fullscreen under Steam's Game Mode (gamescope),
# which scales a window into the screen with black bars, and a window everywhere else.
# fullscreen = 1

# Stop the game when its window loses focus. 0 by default and deliberately: the attract mode and the
# demo match are worth leaving to run, and a benchmark that stopped would report nothing.
# pause_on_focus_lost = 1

# Graphics backend: auto, d3d12, vulkan, metal, opengl, opengles.
# backend = vulkan

# Shaders compiled at once, 0 to 16. 0 picks a count from the CPU cores. Set 1 if the graphics driver
# has problems at startup.
# shader_jobs = 0

# 1 lets the game run on a software renderer when there is no usable graphics card.
# allow_cpu_adapter = 1

[audio]
# Sound: music, effects, the stadium reverb and the movies' own tracks.
# audio = 0

# Master level, 0 to 2, in front of the limiter.
# audio_volume = 1.0

# Report at exit: ticks rendered, underruns, and whether any non-silent sample was produced; plus
# the mixer's state every two seconds.
# log_audio = 1

# Record everything the game plays to a WAV file.
# audio_dump = C:/games/strikers/strikers.wav

[input]
# Controls. Everything here is commented out and the defaults below are what you get without the
# file.

# Print the effective controls to the log at startup, and each controller's state as it changes.
# Any value turns it on.
# probe_pad = 1

# 0 stops the keyboard acting as player 1's controller.
# keyboard = 1

# Button art: auto follows the last input device. gamecube, xbox, playstation, nintendo, steamdeck,
# generic or keyboard shows that family's buttons instead.
# button_prompts = auto

# Keyboard, player 1. SDL scancode names as SDL_GetScancodeName spells them: "A", "Return", "Space",
# "Left Shift", "F1", "Keypad 0".
# key_a = X
# key_b = Z
# key_x = C
# key_y = V
# key_z = Space
# key_start = Return
# key_l = Q
# key_r = E
# key_dpad_up = Up
# key_dpad_down = Down
# key_dpad_left = Left
# key_dpad_right = Right
# key_stick_up = W
# key_stick_down = S
# key_stick_left = A
# key_stick_right = D
# key_cstick_up = I
# key_cstick_down = K
# key_cstick_left = J
# key_cstick_right = L

# Gamepad (all ports). Values are SDL gamepad button names: a b x y back guide start leftstick
# rightstick leftshoulder rightshoulder dpup dpdown dpleft dpright, and for triggers: lefttrigger
# righttrigger.
# pad_a = a
# pad_b = b
# pad_x = x
# pad_y = y
# pad_z = rightshoulder
# pad_start = start
# pad_l = lefttrigger
# pad_r = righttrigger
# pad_dpad_up = dpup
# pad_dpad_down = dpdown
# pad_dpad_left = dpleft
# pad_dpad_right = dpright

# 1 swaps the main stick and the C-stick.
# pad_swap_sticks = 0

# Stick deadzone, 0.0 to 0.9, as a fraction of the stick's travel.
# pad_deadzone = 0.24

# How far an analog trigger is pulled before L or R counts as pressed, as a fraction of its travel.
# pad_trigger_threshold = 0.95

# 0 turns rumble off on every controller.
# pad_rumble = 1

# Rumble strength, 0 to 100.
# pad_rumble_strength = 100

[paths]
# Where the game data is: either the `files` folder of an extracted disc, or a disc image.
# data = C:/games/strikers/files
# data = C:/games/strikers/Super Mario Strikers.iso

# Where the game's reports go: 1 for strikers-log.txt beside it, a file path, or console.
# log = 1
# log = console

# Menu language: english, german, french, spanish or italian, and japanese on the Japanese disc.
# Unset keeps the disc's own language. The American disc ignores this.
# language = german

# Texture packs load from mods/textures/ beside the game and mods/textures/ in the user folder. A
# folder named here loads too and wins over both; 0 turns texture packs off.
# textures = C:/games/strikers/packs/hd pitch

# One pack out of the textures folders, by its folder name. Unset loads every pack.
# texture_pack = hd pitch

# Memory for loaded texture pack images, in MB. Past it the least recently drawn is dropped and
# loaded again when next needed. 4096 by default, 512 on Switch.
# texture_cache_mb = 1024

# Save each texture the game loads as a PNG named for a texture pack, in a folder per disc file.
# 1 saves to texture_dumps/ in the user folder; a path saves there.
# texture_dump = 1

# 1 keeps the user folder and the shader cache in user/ and cache/ beside the game, so the game
# folder can be moved or copied whole. user_dir and cache_dir still apply when set.
# portable = 1

# The user folder: saves, texture packs and texture dumps. Unset, it is %APPDATA%\Super Mario
# Strikers on Windows, ~/Library/Application Support/Super Mario Strikers on macOS and
# ~/.local/share/Super Mario Strikers on Linux.
# user_dir = C:/games/strikers/user

# The compiled shader cache. Unset, it stays in the system folder above even when user_dir is set.
# cache_dir = C:/games/strikers/cache

[game]
# Which disc the data came from, when the data cannot say: the id is read from sys/boot.bin
# beside `files` or from an image's first bytes, and an extraction of `files` alone is taken
# as the USA disc. usa, europe or japan, or a disc id (G4QE01, G4QP01, G4QJ01).
# region = europe

# Every stadium, team and cup mode available.
# unlock_all = 1

[discord]
# Your Discord status while Discord's desktop app runs: in the menus, or a match's mode, cup round,
# stadium, captains, score and time left. On by default; 0 turns it off.
# A room you host gets a Join button once the router opens its port; friends need the game open.
# discord = 0

[online]
# Online play. The game writes these when you change them in the online panel (F5, or hold L+R+Z).
# The name other players see, up to 16 characters.
# online_nickname = "Player"

# Input delay in steps of 20 ms, 1 to 8, or 0 to pick it from the connection.
# online_delay = 0

# 1 shows the connection line during online matches.
# online_stats = 0

# The UDP port a room you host listens on, 1025 to 49151. Guests joining by address need it open.
# online_port = 41210

# 1 finds a hosted room's internet address: the game asks a public STUN server (Cloudflare's, then
# Google's) what address it sees, and asks your router over UPnP to forward online_port. 0 never
# contacts either.
# online_public = 1

[debug]
# The debug overlay and menu. `menu` opens the menu straight away, `1` draws only the compact
# heads-up form.
# overlay = menu

# Force a stadium instead of letting the demo pick at random: mario_stadium, peach_toad, dk_daisy,
# wario_stadium, yoshi_stadium, super_stadium or forbidden_dome, or 0 to 6.
# force_stadium = mario_stadium

# Set the teams and sidekicks: daisy, donkeykong, luigi, mario, peach, waluigi, wario or yoshi,
# and toad, koopa, hammerbro or birdo.
# team1 = mario
# team2 = luigi
# sidekick1 = toad
# sidekick2 = koopa

# Pin the RNG seed, so a run is reproducible.
# seed = 3

# 1 skips the game's movies.
# no_movies = 1

# Extra reports in the log. Any value turns one on; remove the line to turn it off.
# Every front-end screen entered and package loaded:
# log_scenes = 1
# Match state, once a second:
# log_match = 1
# The cutscene player and presentation clock:
# log_nis = 1
# Every bundle file opened:
# log_bundles = 1
