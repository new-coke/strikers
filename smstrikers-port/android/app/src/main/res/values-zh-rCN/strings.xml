    <string name="import_zip">导入 .zip 文件</string>
    <string name="import_zip_sub">符合 libadrenotools 格式的驱动包。</string>
    <string name="drivers_download_note">下载会带来在游戏内运行的第三方代码。这些地址是特意摆出来的。如果其中某个不再响应，请手动下载并使用“导入”。</string>
