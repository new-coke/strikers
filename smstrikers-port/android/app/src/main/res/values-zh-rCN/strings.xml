    <string name="fps_limit">帧数上限</string>
    <string name="fps_follow_display">跟随屏幕</string>
    <string name="fps_help">默认帧率上限跟随屏幕刷新率。降低上限可节省电量。</string>
    <string name="fps_unlimited">不限制</string>
    <string name="vsync">与屏幕同步</string>
    <string name="vsync_help">关闭时帧数自由。开启后呈现要等屏幕，上面的上限就不起作用了，由屏幕说了算。</string>
    <string name="msaa">抗锯齿</string>
